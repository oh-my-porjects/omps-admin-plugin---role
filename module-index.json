    {
      "method": "POST",
      "path": "/api/role/create",
      "title": "创建角色",
      "description": "创建角色，按当前后台账号上下文确定父角色，并可同时绑定权限点。",
      "auth": "public",
      "params": [
        {
          "constraint": "2-30 个字符。",
          "description": "角色名称。",
          "name": "name",
          "required": true,
          "type": "string"
        },
        {
          "constraint": "UUID；与 parent_role_id 同义，parent_role_id 优先。",
          "description": "父角色 ID。",
          "name": "parent_id",
          "required": false,
          "type": "string"
        },
        {
          "constraint": "UUID；非空时覆盖 parent_id。",
          "description": "父角色 ID 兼容字段。",
          "name": "parent_role_id",
          "required": false,
          "type": "string"
        },
        {
          "constraint": "最多 200 个字符。",
          "description": "角色说明。",
          "name": "description",
          "required": false,
          "type": "string"
        },
        {
          "constraint": "enabled 或 disabled。",
          "description": "角色状态。",
          "name": "status",
          "required": true,
          "type": "string"
        },
        {
          "constraint": "每项必须是 UUID，重复值会去重。",
          "description": "初始绑定的权限点 ID 列表。",
          "item_type": "string",
          "name": "permission_ids",
          "required": false,
          "type": "array"
        }
      ],
      "response": {
        "data_type": "object",
        "description": "新创建的角色信息。",
        "error_codes": [
          {
            "msg": "请求体解析失败，或角色名称、状态、说明、父级角色 ID、权限 ID 列表参数不合法。",
            "status": 4101
          },
          {
            "msg": "角色名称已存在或创建角色失败。",
            "status": 4102
          },
          {
            "msg": "手动指定的父级角色不存在。",
            "status": 4103
          },
          {
            "msg": "手动指定的父级角色未启用。",
            "status": 4104
          },
          {
            "msg": "手动指定的父级角色不在当前账号可操作范围内。",
            "status": 4105
          },
          {
            "msg": "当前账号未绑定角色，且不是允许创建顶级角色的超级管理员。",
            "status": 4106
          },
          {
            "msg": "当前账号绑定角色不存在或未启用。",
            "status": 4107
          },
          {
            "msg": "绑定的权限不存在或超出父级角色权限范围。",
            "status": 4108
          },
          {
            "msg": "当前账号身份或角色绑定信息读取失败或缺失。",
            "status": 4109
          }
        ],
        "fields": [
          {
            "description": "角色 ID。",
            "name": "role_id",
            "type": "string"
          },
          {
            "description": "角色名称。",
            "name": "name",
            "type": "string"
          },
          {
            "description": "父角色 ID，顶级角色为空。",
            "name": "parent_id",
            "type": "string"
          },
          {
            "description": "父角色 ID 兼容字段。",
            "name": "parent_role_id",
            "type": "string"
          },
          {
            "description": "父角色名称，创建响应中为空。",
            "name": "parent_name",
            "type": "string"
          },
          {
            "description": "角色状态。",
            "name": "status",
            "type": "string"
          },
          {
            "description": "角色说明。",
            "name": "description",
            "type": "string"
          },
          {
            "description": "创建时间，RFC3339。",
            "name": "created_at",
            "type": "string"
          },
          {
            "description": "更新时间，RFC3339。",
            "name": "updated_at",
            "type": "string"
          },
          {
            "description": "权限对象列表，创建响应为空数组。",
            "fields": [
              {
                "description": "权限点 ID。",
                "name": "permission_id",
                "type": "string"
              },
              {
                "description": "权限点标识。",
                "name": "code",
                "type": "string"
              },
              {
                "description": "权限点名称。",
                "name": "name",
                "type": "string"
              },
              {
                "description": "权限点说明。",
                "name": "description",
                "type": "string"
              },
              {
                "description": "创建时间，RFC3339。",
                "name": "created_at",
                "type": "string"
              }
            ],
            "name": "permissions",
            "type": "array"
          },
          {
            "description": "本次绑定的权限点 ID 列表。",
            "item_type": "string",
            "name": "permission_ids",
            "type": "array"
          }
        ]
      },
      "request_example": {
        "description": "负责运营配置",
        "name": "运营主管",
        "parent_id": "00000000-0000-0000-0000-000000000001",
        "permission_ids": [
          "00000000-0000-0000-0000-000000000002"
        ],
        "status": "enabled"
      },
      "response_example": {
        "data": {
          "created_at": "2026-05-20T04:00:00Z",
          "description": "负责运营配置",
          "name": "运营主管",
          "parent_id": "00000000-0000-0000-0000-000000000001",
          "parent_name": "",
          "parent_role_id": "00000000-0000-0000-0000-000000000001",
          "permission_ids": [
            "00000000-0000-0000-0000-000000000002"
          ],
          "permissions": [],
          "role_id": "00000000-0000-4000-8000-000000000101",
          "status": "enabled",
          "updated_at": "2026-05-20T04:00:00Z"
        },
        "msg": "",
        "status": 0
      }
    },
