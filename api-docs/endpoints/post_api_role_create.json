{
  "method": "POST",
  "path": "/api/role/create",
  "endpoint_key": "POST /api/role/create",
  "title": "创建角色",
  "description": "创建角色，按当前后台账号上下文确定父角色，并可同时绑定权限点。",
  "auth": "public",
  "params": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "constraint": "2-30 个字符。",
      "description": "角色名称。"
    },
    {
      "name": "parent_id",
      "type": "string",
      "required": false,
      "constraint": "UUID；与 parent_role_id 同义，parent_role_id 优先。",
      "description": "父角色 ID。"
    },
    {
      "name": "parent_role_id",
      "type": "string",
      "required": false,
      "constraint": "UUID；非空时覆盖 parent_id。",
      "description": "父角色 ID 兼容字段。"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "constraint": "最多 200 个字符。",
      "description": "角色说明。"
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "constraint": "enabled 或 disabled。",
      "description": "角色状态。",
      "enum": {
        "enabled": "启用",
        "disabled": "停用"
      }
    },
    {
      "name": "permission_ids",
      "type": "array",
      "item_type": "string",
      "required": false,
      "constraint": "每项必须是 UUID，重复值会去重。",
      "description": "初始绑定的权限点 ID 列表。"
    }
  ],
  "request_example": {
    "name": "运营主管",
    "parent_id": "00000000-0000-0000-0000-000000000001",
    "description": "负责运营配置",
    "status": "enabled",
    "permission_ids": [
      "00000000-0000-0000-0000-000000000002"
    ]
  },
  "response": {
    "description": "新创建的角色信息。",
    "data_type": "object",
    "fields": [
      {
        "name": "role_id",
        "type": "string",
        "description": "角色 ID。"
      },
      {
        "name": "name",
        "type": "string",
        "description": "角色名称。"
      },
      {
        "name": "parent_id",
        "type": "string",
        "description": "父角色 ID，顶级角色为空。"
      },
      {
        "name": "parent_role_id",
        "type": "string",
        "description": "父角色 ID 兼容字段。"
      },
      {
        "name": "parent_name",
        "type": "string",
        "description": "父角色名称，创建响应中为空。"
      },
      {
        "name": "status",
        "type": "string",
        "description": "角色状态。",
        "enum": {
          "enabled": "启用",
          "disabled": "停用"
        }
      },
      {
        "name": "description",
        "type": "string",
        "description": "角色说明。"
      },
      {
        "name": "created_at",
        "type": "string",
        "description": "创建时间，RFC3339。"
      },
      {
        "name": "updated_at",
        "type": "string",
        "description": "更新时间，RFC3339。"
      },
      {
        "name": "permissions",
        "type": "array",
        "description": "权限对象列表，创建响应为空数组。",
        "fields": [
          {
            "name": "permission_id",
            "type": "string",
            "description": "权限点 ID。"
          },
          {
            "name": "code",
            "type": "string",
            "description": "权限点标识。"
          },
          {
            "name": "name",
            "type": "string",
            "description": "权限点名称。"
          },
          {
            "name": "description",
            "type": "string",
            "description": "权限点说明。"
          },
          {
            "name": "created_at",
            "type": "string",
            "description": "创建时间，RFC3339。"
          }
        ]
      },
      {
        "name": "permission_ids",
        "type": "array",
        "item_type": "string",
        "description": "本次绑定的权限点 ID 列表。"
      }
    ],
    "error_codes": [
      {
        "status": 4101,
        "msg": "请求体解析失败，或角色名称、状态、说明、父级角色 ID、权限 ID 列表参数不合法。"
      },
      {
        "status": 4102,
        "msg": "角色名称已存在或创建角色失败。"
      },
      {
        "status": 4103,
        "msg": "手动指定的父级角色不存在。"
      },
      {
        "status": 4104,
        "msg": "手动指定的父级角色未启用。"
      },
      {
        "status": 4105,
        "msg": "手动指定的父级角色不在当前账号可操作范围内。"
      },
      {
        "status": 4106,
        "msg": "当前账号未绑定角色，且不是允许创建顶级角色的超级管理员。"
      },
      {
        "status": 4107,
        "msg": "当前账号绑定角色不存在或未启用。"
      },
      {
        "status": 4108,
        "msg": "绑定的权限不存在或超出父级角色权限范围。"
      },
      {
        "status": 4109,
        "msg": "当前账号身份或角色绑定信息读取失败或缺失。"
      }
    ]
  },
  "response_example": {
    "status": 0,
    "data": {
      "role_id": "00000000-0000-4000-8000-000000000101",
      "name": "运营主管",
      "parent_id": "00000000-0000-0000-0000-000000000001",
      "parent_role_id": "00000000-0000-0000-0000-000000000001",
      "parent_name": "",
      "status": "enabled",
      "description": "负责运营配置",
      "created_at": "2026-05-20T04:00:00Z",
      "updated_at": "2026-05-20T04:00:00Z",
      "permissions": [],
      "permission_ids": [
        "00000000-0000-0000-0000-000000000002"
      ]
    },
    "msg": ""
  },
  "rules": [
    {
      "category": "security",
      "title": "创建角色受当前后台账号角色范围限制",
      "body": "未显式传父角色时，普通账号必须且只能绑定一个角色；显式传父角色时，该父角色必须存在、启用，并位于当前账号可操作范围内。",
      "code_loc": "role_handlers.go:54-105"
    },
    {
      "category": "constraint",
      "title": "子角色权限不得超出父角色",
      "body": "创建角色时绑定的权限点必须存在，并且必须是父角色权限集合的子集；顶级角色不受父角色集合限制。",
      "code_loc": "role_handlers.go:45-108"
    }
  ]
}
