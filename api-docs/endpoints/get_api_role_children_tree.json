          "status": "enabled",
          "description": "活动配置执行",
          "has_children": false,
          "children_count": 0,
          "children": []
        }
      ]
    }
  },
  "rules": [
    {
      "category": "business",
      "title": "查子树",
      "body": "按角色 ID 拉取该角色下的完整未删除子角色树，用于删除前展示影响范围。",
      "code_loc": "role_handlers.go"
    }
  ]
}
