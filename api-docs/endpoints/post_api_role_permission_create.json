{
  "method": "POST",
  "path": "/api/role/permission-create",
  "endpoint_key": "POST /api/role/permission-create",
  "title": "创建权限点",
  "description": "创建可绑定到角色的权限点。",
  "auth": "public",
  "params": [
    {
      "name": "code",
      "type": "string",
      "required": true,
      "constraint": "3-80 个字符，仅允许小写字母、数字、点、下划线、短横线。",
      "description": "权限点标识。"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "constraint": "2-30 个字符。",
      "description": "权限点名称。"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "constraint": "最多 200 个字符。",
      "description": "权限点说明。"
    }
  ],
  "request_example": {
    "code": "order.read",
    "name": "查看订单",
    "description": "允许查看订单列表和详情"
  },
  "response": {
    "description": "新创建的权限点。",
    "data_type": "object",
    "fields": [
      {
        "name": "permission_id",
        "type": "string",
        "description": "权限点 ID。"
      },
      {
        "name": "code",
        "type": "string",
        "description": "权限点标识。",
        "enum_values": [
          {
            "value": 0,
            "label": "成功"
          },
          {
            "value": 1,
            "label": "失败或未注册"
          }
        ]
      },
      {
        "name": "name",
        "type": "string",
        "description": "权限点名称。"
      },
      {
        "name": "description",
        "type": "string",
        "description": "权限点说明。"
      },
      {
        "name": "created_at",
        "type": "string",
        "description": "创建时间，RFC3339。"
      }
    ],
    "error_codes": [
      {
        "status": 2141,
        "msg": "请求体解析失败，或权限点标识缺失/格式不合法。"
      },
      {
        "status": 2142,
        "msg": "权限点名称缺失/长度不合法，或权限点说明过长。"
      },
      {
        "status": 2143,
        "msg": "权限点标识已存在。"
      },
      {
        "status": 2144,
        "msg": "创建权限点失败。"
      }
    ]
  },
  "response_example": {
    "status": 0,
    "data": {
      "permission_id": "00000000-0000-4000-8000-000000000201",
      "code": "order.read",
      "name": "查看订单",
      "description": "允许查看订单列表和详情",
      "created_at": "2026-05-20T04:00:00Z"
    },
    "msg": ""
  },
  "rules": [
    {
      "category": "constraint",
      "title": "创建权限点 参数与状态校验",
      "body": "该写入接口必须先校验必填参数、业务状态和数据存在性；校验失败时返回业务错误且不能产生不一致副作用。接口职责：创建可绑定到角色的权限点。",
      "code_loc": "main.go:137"
    }
  ]
}
