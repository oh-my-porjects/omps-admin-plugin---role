{
  "api": "PUT /api/role/update",
  "cases": [
    {
      "name": "update seeded role",
      "actor": "admin",
      "depends_on": [],
      "method": "PUT",
      "path": "/api/role/update",
      "body": {
        "role_id": "11111111-1111-4111-8111-000000000002",
        "name": "${range_tag}updated_${rand:8}",
        "parent_id": "00000000-0000-0000-0000-000000000001",
        "description": "${range_tag}updated role",
        "status": "enabled"
      },
      "expect_status": 200,
      "expect_business_status": 0,
      "expect_field": {
        "data.role_id": "11111111-1111-4111-8111-000000000002"
      },
      "side_effect_tables": ["role_roles"]
    },
    {
      "name": "update missing role fails",
      "actor": "admin",
      "depends_on": [],
      "method": "PUT",
      "path": "/api/role/update",
      "body": {
        "role_id": "99999999-9999-9999-9999-999999999999",
        "name": "${range_tag}missing_${rand:8}",
        "parent_id": "",
        "description": "${range_tag}missing role",
        "status": "enabled"
      },
      "expect_status": 200,
      "expect_business_status": 2132,
      "side_effect_tables": ["role_roles"]
    },
    {
      "name": "update invalid parent id fails",
      "actor": "admin",
      "depends_on": [],
      "method": "PUT",
      "path": "/api/role/update",
      "body": {
        "role_id": "11111111-1111-4111-8111-000000000002",
        "name": "${range_tag}invalid_parent_${rand:8}",
        "parent_id": "not-a-uuid",
        "description": "${range_tag}invalid parent",
        "status": "enabled"
      },
      "expect_status": 200,
      "expect_business_status": 2134,
      "side_effect_tables": ["role_roles"]
    }
  ]
}
